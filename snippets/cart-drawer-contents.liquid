{%- if cart.item_count == 0 -%}
  <div class="empty-state">
    {% render 'icon', name: 'bag-empty' %}
    <h3 class="h4">{{ 'sections.cart.empty' | t }}</h3>
    <p class="text-muted">{{ 'sections.cart.empty_text' | t }}</p>
    <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
  </div>
{%- else -%}
  {%- if settings.free_shipping_bar and settings.free_shipping_threshold > 0 -%}
    {%- assign threshold = settings.free_shipping_threshold | times: 100 -%}
    {%- assign remaining = threshold | minus: cart.total_price -%}
    {%- assign percent = cart.total_price | times: 100 | divided_by: threshold -%}
    <div class="ship-bar" data-ship-bar>
      <span data-ship-text>
        {%- if remaining > 0 -%}
          {{ 'sections.cart.free_shipping_remaining' | t: amount: remaining | money }}
        {%- else -%}
          {{ 'sections.cart.free_shipping_qualified' | t }}
        {%- endif -%}
      </span>
      <span class="ship-bar__track">
        <span class="ship-bar__fill" data-ship-fill style="width: {% if percent > 100 %}100{% else %}{{ percent }}{% endif %}%"></span>
      </span>
    </div>
  {%- endif -%}

  <ul>
    {%- for item in cart.items -%}
      <li class="line-item" data-line-item>
        <a class="line-item__media media media--portrait" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
          {%- if item.image -%}
            {{ item.image | image_url: width: 220 | image_tag: loading: 'lazy', alt: item.title }}
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </a>

        <div class="line-item__info">
          <a class="line-item__title" href="{{ item.url }}">{{ item.product.title }}</a>

          {%- unless item.product.has_only_default_variant -%}
            <span class="line-item__variant">{{ item.variant.title }}</span>
          {%- endunless -%}

          {%- if item.properties != blank -%}
            {%- for property in item.properties -%}
              {%- unless property.last == blank or property.first[0] == '_' -%}
                <span class="line-item__variant">{{ property.first }}: {{ property.last }}</span>
              {%- endunless -%}
            {%- endfor -%}
          {%- endif -%}

          {%- if item.line_level_discount_allocations.size > 0 -%}
            {%- for allocation in item.line_level_discount_allocations -%}
              <span class="line-item__discount">
                {{ allocation.discount_application.title }} (−{{ allocation.amount | money }})
              </span>
            {%- endfor -%}
          {%- endif -%}

          {%- if item.selling_plan_allocation -%}
            <span class="line-item__variant">{{ item.selling_plan_allocation.selling_plan.name }}</span>
          {%- endif -%}

          <div class="line-item__foot">
            {%- liquid
              assign drawer_qty_id = 'DrawerQty-' | append: forloop.index
              assign drawer_qty_label = 'sections.cart.quantity' | t
            -%}
            {% render 'quantity-input',
              input_id: drawer_qty_id,
              value: item.quantity,
              min: 0,
              line: forloop.index,
              label: drawer_qty_label
            %}
            <div class="stack" style="gap: 0.2rem; align-items: flex-end;">
              <span class="text-sm">{{ item.final_line_price | money }}</span>
              {%- if item.original_line_price != item.final_line_price -%}
                <s class="text-sm text-muted">{{ item.original_line_price | money }}</s>
              {%- endif -%}
              <button type="button" class="line-item__remove" data-line-remove data-line="{{ forloop.index }}">
                {{ 'sections.cart.remove' | t }}
              </button>
            </div>
          </div>
        </div>
      </li>
    {%- endfor -%}
  </ul>

  {%- if settings.cart_show_note -%}
    <details class="accordion" style="margin-top: 1.6rem;">
      <summary class="accordion__summary">
        <span class="text-sm">{{ 'sections.cart.note' | t }}</span>
        <span class="accordion__icon"></span>
      </summary>
      <div style="padding-bottom: 1.6rem;">
        <label class="visually-hidden" for="CartDrawerNote">{{ 'sections.cart.note' | t }}</label>
        <textarea
          id="CartDrawerNote"
          class="textarea"
          data-cart-note
          placeholder="{{ 'sections.cart.note_placeholder' | t }}"
          style="min-height: 8rem;"
        >{{ cart.note }}</textarea>
      </div>
    </details>
  {%- endif -%}
{%- endif -%}
