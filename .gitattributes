# Keep line endings stable between Windows, the Shopify GitHub sync and CI.
# Shopify commits back to this repo with LF, so normalise everything to LF.
* text=auto eol=lf

*.liquid  text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.ps1     text eol=crlf

*.jpg  binary
*.jpeg binary
*.png  binary
*.gif  binary
*.webp binary
*.svg  binary
*.ico  binary
*.woff  binary
*.woff2 binary
