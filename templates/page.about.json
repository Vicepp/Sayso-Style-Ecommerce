        "b2": { "type": "heading", "settings": { "text": "Fewer fabrics, better ones", "size": "h2" } },
        "b3": {
          "type": "text",
          "settings": {
            "text": "<p>We work with a short list of mills and buy deadstock wherever the quantity allows. It limits what we can make, which is the point — scarcity keeps the runs small and the standard high.</p>",
