      "blocks": {
        "b1": { "type": "eyebrow", "settings": { "text": "The workshops" } },
        "b2": { "type": "heading", "settings": { "text": "Two rooms, named on the label", "size": "h2" } },
        "b3": {
          "type": "text",
          "settings": {
            "text": "<p>Our knitwear is made outside Porto by a family workshop we have used since the first season. Our tailoring is cut in east London, ten minutes from the studio. We visit both every season, and every product page tells you which one made the piece.</p>",
            "large": false,
            "muted": true
          }
        },
