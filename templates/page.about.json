    "intro": {
      "type": "rich-text",
      "blocks": {
        "r1": { "type": "eyebrow", "settings": { "text": "Why we started" } },
        "r2": {
          "type": "heading",
          "settings": { "text": "We got tired of replacing things", "size": "h2" }
        },
        "r3": {
          "type": "text",
          "settings": {
            "text": "<p>Sayso Style began in a back room with one pattern, one fabric roll, and a question we could not shake: what would clothing look like if it were designed to be kept rather than replaced? Everything since has been an answer to that.</p>"
          }
        }
      },
