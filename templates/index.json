    "faq": {
      "type": "faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Orders leave the studio within two working days. UK delivery takes 2–3 days, Europe 3–5, and the rest of the world 5–8. Shipping is complimentary over $150.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "What is your returns policy?",
            "answer": "<p>Thirty days from delivery, unworn and with tags attached. Post it back with the enclosed label and we refund to the original payment method within five working days.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "How should I choose a size?",
            "answer": "<p>Every product page lists the exact garment measurements and the height and size of the model. If you are between sizes, size down in knitwear and up in outerwear — or write to us and we will measure the piece for you.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Do you really repair things for free?",
            "answer": "<p>Yes. Seams, buttons, zips, moth holes. Send it in and we will fix it at no cost for as long as you own it. We only ask that you cover postage to us.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Where are your clothes made?",
            "answer": "<p>In two family-run workshops, one outside Porto and one in east London. Both are named on the product page of anything they made.</p>"
          }
        }
      },
      "block_order": ["q1", "q2", "q3", "q4", "q5"],
      "settings": {
        "eyebrow": "Help",
        "heading": "Questions, answered",
        "text": "<p>Still not sure? Write to us and a real person replies within two working days.</p>",
