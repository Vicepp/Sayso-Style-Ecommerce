<section class="section" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="error-page" data-reveal-group>
      <span class="error-page__code" aria-hidden="true" data-reveal="scale">404</span>
      <h1 class="h2" data-reveal="rise">{{ section.settings.heading }}</h1>
      <div class="rte text-muted" style="max-width: 46ch;" data-reveal="rise">{{ section.settings.text }}</div>

      <form action="{{ routes.search_url }}" method="get" role="search" class="row" style="max-width: 44rem; width: 100%;" data-reveal="rise">
        <label class="visually-hidden" for="NotFoundSearch">{{ 'general.search.search' | t }}</label>
        <input
          id="NotFoundSearch"
          class="input"
          type="search"
          name="q"
          placeholder="{{ 'general.search.placeholder' | t }}"
        >
        <button class="btn" type="submit">{{ 'general.search.submit' | t }}</button>
      </form>

      <div class="row row--wrap" style="justify-content: center;" data-reveal="rise">
        <a class="btn btn--secondary" href="{{ routes.root_url }}">{{ 'general.continue_shopping' | t }}</a>
        <a class="btn btn--secondary" href="{{ routes.all_products_collection_url }}">
          {{ 'sections.collection.browse' | t }}
        </a>
      </div>
    </div>

    {%- if section.settings.collection != blank -%}
      <div style="margin-top: 4rem;">
        <div class="section-head section-head--center" data-reveal="fade">
          <div class="section-head__text">
            <h2 class="h4">{{ section.settings.suggestions_heading }}</h2>
          </div>
        </div>
        <div class="grid grid--4" data-reveal-group>
          {%- for product in section.settings.collection.products limit: 4 -%}
            {% render 'product-card', card_product: product %}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "404 page",
  "class": "main-404-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page has wandered off" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>The link may be old, or the piece may have sold out. Try a search, or start again from the beginning.</p>"
    },
    { "type": "collection", "id": "collection", "label": "Suggested collection" },
    { "type": "text", "id": "suggestions_heading", "label": "Suggestions heading", "default": "You might like" }
  ]
}
{% endschema %}
