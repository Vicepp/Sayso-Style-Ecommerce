<section
  class="section scheme-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-head section-head--center" data-reveal="{{ settings.anim_reveal_style }}">
        <div class="section-head__text">
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          <h2>{{ section.settings.heading }}</h2>
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.layout == 'carousel' -%}
      <carousel-element class="carousel">
        <div class="carousel__track" data-carousel-track style="grid-auto-columns: 88%;" data-reveal-group>
          {%- for block in section.blocks -%}
            {% render 'testimonial-card', block: block %}
          {%- endfor -%}
        </div>
        <div class="carousel__nav" style="justify-content: center; margin-top: 2.4rem;">
          <button class="carousel__btn" type="button" data-carousel-prev aria-label="{{ 'accessibility.previous_slide' | t }}">
            {% render 'icon', name: 'arrow-left' %}
          </button>
          <button class="carousel__btn" type="button" data-carousel-next aria-label="{{ 'accessibility.next_slide' | t }}">
            {% render 'icon', name: 'arrow-right' %}
          </button>
        </div>
      </carousel-element>
    {%- else -%}
      <div class="grid grid--{{ section.blocks.size | at_most: 3 }}" data-reveal-group>
        {%- for block in section.blocks -%}
          {% render 'testimonial-card', block: block %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "class": "testimonials-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Wearers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What people say" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" }
      ],
      "default": "grid"
    },
    { "type": "header", "content": "Appearance" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "light"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 80 }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Quote",
          "default": "The linen shirt has been in rotation for two summers and looks better now than the day it arrived."
        },
        { "type": "text", "id": "author", "label": "Author", "default": "Ines M." },
        { "type": "text", "id": "detail", "label": "Detail", "default": "Verified buyer" },
        { "type": "range", "id": "rating", "min": 0, "max": 5, "step": 1, "label": "Stars", "default": 5 },
        { "type": "image_picker", "id": "image", "label": "Portrait" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [{ "type": "quote" }, { "type": "quote" }, { "type": "quote" }]
    }
  ]
}
{% endschema %}
