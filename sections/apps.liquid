<section
  class="section scheme-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="{% if section.settings.full_width %}page-width page-width--full{% else %}page-width{% endif %}">
    {%- if section.settings.heading != blank -%}
      <div class="section-head section-head--center" data-reveal="{{ settings.anim_reveal_style }}">
        <div class="section-head__text">
          <h2>{{ section.settings.heading }}</h2>
        </div>
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        {% render block %}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Apps",
  "class": "apps-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "light"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Apps" }]
}
{% endschema %}
