<announcement-bar
  class="announcement scheme-{{ section.settings.color_scheme }}"
  data-rotate="{{ section.settings.rotate }}"
  data-speed="{{ section.settings.speed }}"
>
  <div class="page-width">
    <div class="announcement__viewport">
      {%- for block in section.blocks -%}
        <div class="announcement__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a class="hover-line" href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            <span>{{ block.settings.text }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}

      {%- if section.blocks.size > 1 -%}
        <button
          class="announcement__nav announcement__nav--prev"
          type="button"
          data-announcement-prev
          aria-label="{{ 'accessibility.previous_announcement' | t }}"
        >
          {% render 'icon', name: 'arrow-left' %}
        </button>
        <button
          class="announcement__nav announcement__nav--next"
          type="button"
          data-announcement-next
          aria-label="{{ 'accessibility.next_announcement' | t }}"
        >
          {% render 'icon', name: 'arrow-right' %}
        </button>
      {%- endif -%}
    </div>
  </div>
</announcement-bar>

{% schema %}
{
  "name": "Announcement bar",
  "class": "announcement-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "dark"
    },
    {
      "type": "checkbox",
      "id": "rotate",
      "label": "Rotate messages automatically",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Seconds per message",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Message",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Complimentary shipping on orders over $150"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "default": {
    "settings": {},
    "blocks": [
      { "type": "announcement" }
    ]
  },
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
