<section
  class="section scheme-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;{% if section.settings.image != blank %} position: relative; isolation: isolate; color: #fff;{% endif %}"
>
  {%- if section.settings.image != blank or section.settings.fallback_image != blank -%}
    <div class="hero__media{% if settings.anim_parallax %} parallax-media{% endif %}" data-parallax="0.12">
      {% render 'media-fallback',
        image: section.settings.image,
        asset: section.settings.fallback_image,
        placeholder: '',
        alt: section.settings.heading,
        widths: '600, 900, 1400, 1800, 2400',
        sizes: '100vw'
      %}
    </div>
    <div class="hero__overlay" style="--overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  {%- endif -%}

  <div class="page-width page-width--narrow text-center">
    <div class="stack" style="align-items: center; gap: 1.6rem;" data-reveal-group>
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow" data-reveal="rise" style="color: currentColor; opacity: 0.75;">
          {{ section.settings.eyebrow }}
        </span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="{{ section.settings.heading_size }}" data-reveal="rise">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="rte text-lg" data-reveal="rise" style="max-width: 48ch; opacity: 0.85;">{{ section.settings.text }}</div>
      {%- endif -%}

      <div data-reveal="rise" style="width: 100%; display: flex; justify-content: center;">
        {%- form 'customer', class: 'newsletter-form', id: 'NewsletterForm-' | append: section.id -%}
          {%- if form.posted_successfully? -%}
            <p class="form__message form__message--success" style="width: 100%; justify-content: center;">
              {% render 'icon', name: 'check' %}
              {{ 'general.newsletter.success' | t }}
            </p>
          {%- else -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">
              {{ 'general.newsletter.label' | t }}
            </label>
            <input
              id="NewsletterEmail-{{ section.id }}"
              class="input"
              type="email"
              name="contact[email]"
              placeholder="{{ 'general.newsletter.placeholder' | t }}"
              autocomplete="email"
              required
            >
            <button class="btn" type="submit">{{ section.settings.button_label }}</button>
            {%- if form.errors -%}
              <p class="form__message form__message--error" style="width: 100%;">{{ form.errors.messages.email }}</p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>

      {%- if section.settings.disclaimer != blank -%}
        <p class="text-sm" style="opacity: 0.7;" data-reveal="fade">{{ section.settings.disclaimer }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "class": "newsletter-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Letters" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Notes from the studio" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>New work, restocks and the occasional sale. Roughly once a month, never more.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign up" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "Unsubscribe any time." },
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    {
      "type": "text",
      "id": "fallback_image",
      "label": "Fallback asset filename",
      "info": "Leave blank for a plain background.",
      "default": "newsletter-bg.jpg"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Image darkening",
      "default": 45
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "dark"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Top padding", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Bottom padding", "default": 96 }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
