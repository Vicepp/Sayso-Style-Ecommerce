{%- liquid
  assign recs = recommendations.products
-%}

<section
  class="section scheme-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if recommendations.performed and recs.size > 0 -%}
      <div class="section-head" data-reveal="{{ settings.anim_reveal_style }}">
        <div class="section-head__text">
          <h2 class="h3">{{ section.settings.heading }}</h2>
        </div>
        <div class="carousel__nav">
          <button class="carousel__btn" type="button" data-carousel-prev aria-label="{{ 'accessibility.previous_slide' | t }}">
            {% render 'icon', name: 'arrow-left' %}
          </button>
          <button class="carousel__btn" type="button" data-carousel-next aria-label="{{ 'accessibility.next_slide' | t }}">
            {% render 'icon', name: 'arrow-right' %}
          </button>
        </div>
      </div>

      <carousel-element class="carousel">
        <div class="carousel__track" data-carousel-track data-reveal-group>
          {%- for recommendation in recs -%}
            {% render 'product-card', card_product: recommendation %}
          {%- endfor -%}
        </div>
      </carousel-element>
    {%- endif -%}
  </div>
</section>

<script>
  // The recommendations object is only populated on the Section Rendering API
  // response, so fetch it once the product page has painted.
  (function () {
    var section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section || section.querySelector('carousel-element')) return;

    var url =
      '{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent={{ section.settings.intent }}';

    fetch(url)
      .then(function (res) {
        return res.text();
      })
      .then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var incoming = doc.querySelector('[data-section-id="{{ section.id }}"]');
        if (incoming) {
          section.innerHTML = incoming.innerHTML;
          if (window.themeReveal) window.themeReveal(section);
        }
      })
      .catch(function () {
        section.remove();
      });
  })();
</script>

{% schema %}
{
  "name": "Product recommendations",
  "class": "product-recommendations-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wear it with" },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation type",
      "options": [
        { "value": "related", "label": "Related products" },
        { "value": "complementary", "label": "Complementary products" }
      ],
      "default": "related"
    },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 8 },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "light"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 80 }
  ]
}
{% endschema %}
