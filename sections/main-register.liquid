<section class="section" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="auth-card" data-reveal-group>
      <h1 class="h3 text-center" data-reveal="rise">{{ 'customer.register.title' | t }}</h1>

      {%- form 'create_customer', class: 'stack', style: 'margin-top: 2.4rem;' -%}
        {%- if form.errors -%}
          <div class="form__message form__message--error">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <div class="grid grid--2">
          <div class="field">
            <label class="field__label" for="RegisterFirst">{{ 'customer.register.first_name' | t }}</label>
            <input
              id="RegisterFirst"
              class="input"
              type="text"
              name="customer[first_name]"
              value="{{ form.first_name }}"
              autocomplete="given-name"
            >
          </div>
          <div class="field">
            <label class="field__label" for="RegisterLast">{{ 'customer.register.last_name' | t }}</label>
            <input
              id="RegisterLast"
              class="input"
              type="text"
              name="customer[last_name]"
              value="{{ form.last_name }}"
              autocomplete="family-name"
            >
          </div>
        </div>

        <div class="field">
          <label class="field__label" for="RegisterEmail">{{ 'customer.register.email' | t }}</label>
          <input
            id="RegisterEmail"
            class="input"
            type="email"
            name="customer[email]"
            value="{{ form.email }}"
            autocomplete="email"
            required
          >
        </div>

        <div class="field">
          <label class="field__label" for="RegisterPassword">{{ 'customer.register.password' | t }}</label>
          <input
            id="RegisterPassword"
            class="input"
            type="password"
            name="customer[password]"
            autocomplete="new-password"
            required
          >
        </div>

        {%- if section.settings.show_newsletter_optin -%}
          <label class="row" style="gap: 0.9rem; align-items: flex-start;">
            <input type="checkbox" name="customer[accepts_marketing]" value="true" style="width: 1.8rem; height: 1.8rem; margin-top: 0.3rem;">
            <span class="text-sm text-muted">{{ section.settings.newsletter_text }}</span>
          </label>
        {%- endif -%}

        <button class="btn btn--full" type="submit">{{ 'customer.register.submit' | t }}</button>
      {%- endform -%}

      <hr style="margin-block: 2.4rem;">

      <div class="text-center stack" style="gap: 1rem;">
        <span class="text-muted text-sm">{{ 'customer.register.has_account' | t }}</span>
        <a class="btn btn--secondary btn--full" href="{{ routes.account_login_url }}">{{ 'customer.register.log_in' | t }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Register",
  "class": "main-register-section",
  "settings": [
    { "type": "checkbox", "id": "show_newsletter_optin", "label": "Show newsletter opt-in", "default": true },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Opt-in text",
      "default": "Send me occasional notes about new work and restocks."
    }
  ]
}
{% endschema %}
