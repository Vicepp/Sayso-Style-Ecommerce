{%- liquid
  assign target = section.settings.product
-%}

<section
  class="section scheme-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="split{% if section.settings.reverse %} split--reverse{% endif %}">
      <div class="split__media media media--portrait{% if settings.anim_image_zoom %} zoom-media{% endif %}" data-reveal="mask">
        <a href="{{ target.url | default: routes.all_products_collection_url }}">
          {% render 'media-fallback',
            image: target.featured_media,
            asset: 'feature-2.jpg',
            placeholder: 'product-apparel-3',
            alt: target.title,
            widths: '400, 600, 900, 1200, 1400',
            sizes: '(min-width: 750px) 50vw, 100vw'
          %}
        </a>
      </div>

      <div class="split__content" data-reveal-group>
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow" data-reveal="rise">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        <h2 data-reveal="rise">{{ target.title | default: 'onboarding.product_title' | t }}</h2>

        <div data-reveal="rise">
          {% render 'price', product: target, use_variant: true %}
        </div>

        {%- if section.settings.text != blank -%}
          <div class="rte text-muted" data-reveal="rise" style="max-width: 48ch;">{{ section.settings.text }}</div>
        {%- elsif target.description != blank -%}
          <div class="rte text-muted" data-reveal="rise" style="max-width: 48ch;">
            {{ target.description | strip_html | truncatewords: 44 }}
          </div>
        {%- endif -%}

        {%- if target != blank -%}
          <div class="row row--wrap" data-reveal="rise">
            {%- if target.available and target.variants.size == 1 -%}
              <button class="btn" type="button" data-quick-add="{{ target.selected_or_first_available_variant.id }}">
                {{ 'products.product.add_to_cart' | t }}
              </button>
            {%- endif -%}
            <a class="btn btn--secondary" href="{{ target.url }}">{{ 'products.product.view_details' | t }}</a>
          </div>
        {%- else -%}
          <a class="btn btn--secondary" href="{{ routes.all_products_collection_url }}" data-reveal="rise">
            {{ 'general.view_all' | t }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured product",
  "class": "featured-product-section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Piece of the month" },
    { "type": "richtext", "id": "text", "label": "Text override" },
    { "type": "checkbox", "id": "reverse", "label": "Image on the right", "default": false },
    { "type": "header", "content": "Appearance" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "light"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 80 }
  ],
  "presets": [{ "name": "Featured product" }]
}
{% endschema %}
