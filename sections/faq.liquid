<section
  class="section scheme-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="split{% if section.settings.layout == 'stacked' %} split--stacked{% endif %}" style="{% if section.settings.layout == 'stacked' %}display:block;max-width:76rem;margin-inline:auto;{% else %}align-items:start;{% endif %}">
      <div class="split__content" style="position: sticky; top: calc(var(--header-height) + 3rem);" data-reveal="{{ settings.anim_reveal_style }}">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="rte text-muted" style="max-width: 40ch;">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="link-arrow" href="{{ section.settings.button_link | default: routes.root_url }}">
            {{ section.settings.button_label }}
            {% render 'icon', name: 'arrow-right' %}
          </a>
        {%- endif -%}
      </div>

      <accordion-element data-single="{{ section.settings.one_at_a_time }}" data-reveal-group>
        {%- for block in section.blocks -%}
          <div class="accordion{% if forloop.first and section.settings.open_first %} is-open{% endif %}" data-reveal="{{ settings.anim_reveal_style }}" {{ block.shopify_attributes }}>
            <button
              class="accordion__summary"
              type="button"
              aria-expanded="{% if forloop.first and section.settings.open_first %}true{% else %}false{% endif %}"
              aria-controls="Faq-{{ section.id }}-{{ forloop.index }}"
            >
              <span>{{ block.settings.question }}</span>
              <span class="accordion__icon" aria-hidden="true"></span>
            </button>
            <div class="accordion__panel" id="Faq-{{ section.id }}-{{ forloop.index }}">
              <div>
                <div class="accordion__content rte">{{ block.settings.answer }}</div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </accordion-element>
    </div>
  </div>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ block.settings.answer | strip_html | json }}
          }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "FAQ",
  "class": "faq-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Help" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Still not sure? Write to us and a real person replies within two working days.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Link label", "default": "Contact us" },
    { "type": "url", "id": "button_link", "label": "Link" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "split", "label": "Two columns" },
        { "value": "stacked", "label": "Single column" }
      ],
      "default": "split"
    },
    { "type": "checkbox", "id": "one_at_a_time", "label": "Open one at a time", "default": true },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": true },
    { "type": "header", "content": "Appearance" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "light"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 80 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does delivery take?" },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Orders leave the studio within two working days. UK delivery takes 2–3 days, Europe 3–5, and the rest of the world 5–8.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
