{%- liquid
  assign products = section.settings.collection.products
  assign limit = section.settings.products_to_show
-%}

<section
  class="section scheme-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="section-head{% if section.settings.align == 'center' %} section-head--center{% endif %}" data-reveal="{{ settings.anim_reveal_style }}">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte text-muted" style="margin-top: 1rem;">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      <div class="row" style="gap: 1.6rem;">
        {%- if section.settings.layout == 'carousel' -%}
          <div class="carousel__nav">
            <button class="carousel__btn" type="button" data-carousel-prev aria-label="{{ 'accessibility.previous_slide' | t }}">
              {% render 'icon', name: 'arrow-left' %}
            </button>
            <button class="carousel__btn" type="button" data-carousel-next aria-label="{{ 'accessibility.next_slide' | t }}">
              {% render 'icon', name: 'arrow-right' %}
            </button>
          </div>
        {%- endif -%}

        {%- if section.settings.show_view_all and section.settings.collection != blank -%}
          <a class="link-arrow" href="{{ section.settings.collection.url }}">
            {{ 'sections.featured_collection.view_all' | t }}
            {% render 'icon', name: 'arrow-right' %}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.layout == 'carousel' -%}
      <carousel-element class="carousel">
        <div class="carousel__track" data-carousel-track data-reveal-group>
          {%- if products.size > 0 -%}
            {%- for product in products limit: limit -%}
              {% render 'product-card', card_product: product, image_ratio: section.settings.image_ratio %}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..limit) -%}
              {% render 'product-card', image_ratio: section.settings.image_ratio %}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </carousel-element>
    {%- else -%}
      <div class="grid grid--{{ section.settings.columns }}" data-reveal-group>
        {%- if products.size > 0 -%}
          {%- for product in products limit: limit -%}
            {% render 'product-card', card_product: product, image_ratio: section.settings.image_ratio %}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..limit) -%}
            {% render 'product-card', image_ratio: section.settings.image_ratio %}
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "class": "featured-collection-section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New in" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This season" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h3", "label": "Small" },
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h2"
    },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "select",
      "id": "align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "natural", "label": "Natural" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "tall", "label": "Tall" }
      ],
      "default": "portrait"
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'view all' link", "default": true },
    { "type": "header", "content": "Appearance" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "light"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 80 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
