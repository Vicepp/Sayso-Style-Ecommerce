<section
  class="section scheme-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="split" style="align-items: start;">
      <div class="split__content" data-reveal="{{ settings.anim_reveal_style }}">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte text-muted" style="max-width: 44ch;">{{ section.settings.text }}</div>
        {%- endif -%}

        <div class="stack" style="gap: 1.2rem; margin-top: 1.6rem;">
          {%- if section.settings.email != blank -%}
            <a class="row" href="mailto:{{ section.settings.email }}" style="gap: 1rem;">
              <span style="width: 2rem; color: var(--c-accent);">{% render 'icon', name: 'mail' %}</span>
              <span>{{ section.settings.email }}</span>
            </a>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <a class="row" href="tel:{{ section.settings.phone | replace: ' ', '' }}" style="gap: 1rem;">
              <span style="width: 2rem; color: var(--c-accent);">{% render 'icon', name: 'phone' %}</span>
              <span>{{ section.settings.phone }}</span>
            </a>
          {%- endif -%}
          {%- if section.settings.address != blank -%}
            <div class="row" style="gap: 1rem; align-items: flex-start;">
              <span style="width: 2rem; color: var(--c-accent);">{% render 'icon', name: 'pin' %}</span>
              <span class="rte">{{ section.settings.address }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>

      <div data-reveal="{{ settings.anim_reveal_style }}">
        {%- form 'contact', id: 'ContactForm', class: 'stack' -%}
          {%- if form.posted_successfully? -%}
            <p class="form__message form__message--success">
              {% render 'icon', name: 'check' %}
              {{ 'sections.contact.success' | t }}
            </p>
          {%- elsif form.errors -%}
            <div class="form__message form__message--error">
              <span>{{ form.errors | default_errors }}</span>
            </div>
          {%- endif -%}

          <div class="grid grid--2">
            <div class="field">
              <label class="field__label" for="ContactName">{{ 'sections.contact.name' | t }}</label>
              <input
                id="ContactName"
                class="input"
                type="text"
                name="contact[{{ 'sections.contact.name' | t }}]"
                value="{{ form.name | default: customer.name }}"
                autocomplete="name"
              >
            </div>
            <div class="field">
              <label class="field__label" for="ContactEmail">{{ 'sections.contact.email' | t }}</label>
              <input
                id="ContactEmail"
                class="input"
                type="email"
                name="contact[email]"
                value="{{ form.email | default: customer.email }}"
                autocomplete="email"
                required
              >
            </div>
          </div>

          <div class="grid grid--2">
            <div class="field">
              <label class="field__label" for="ContactPhone">{{ 'sections.contact.phone' | t }}</label>
              <input
                id="ContactPhone"
                class="input"
                type="tel"
                name="contact[{{ 'sections.contact.phone' | t }}]"
                value="{{ form.phone }}"
                autocomplete="tel"
              >
            </div>
            <div class="field">
              <label class="field__label" for="ContactSubject">{{ 'sections.contact.subject' | t }}</label>
              <select id="ContactSubject" class="select" name="contact[{{ 'sections.contact.subject' | t }}]">
                {%- assign subjects = section.settings.subjects | split: ',' -%}
                {%- for subject in subjects -%}
                  <option value="{{ subject | strip | escape }}">{{ subject | strip }}</option>
                {%- endfor -%}
              </select>
            </div>
          </div>

          <div class="field">
            <label class="field__label" for="ContactMessage">{{ 'sections.contact.message' | t }}</label>
            <textarea id="ContactMessage" class="textarea" name="contact[body]" required>{{ form.body }}</textarea>
          </div>

          <button class="btn" type="submit" style="align-self: flex-start;">{{ 'sections.contact.send' | t }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "class": "contact-form-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Say hello" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk to a person" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Sizing, alterations, repairs, wholesale — whatever it is, we read every message and reply within two working days.</p>"
    },
    {
      "type": "text",
      "id": "subjects",
      "label": "Subject options",
      "info": "Comma separated.",
      "default": "General question, Order or delivery, Returns, Sizing and fit, Repairs, Wholesale, Press"
    },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@saysostyle.com" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+44 20 7946 0812" },
    { "type": "richtext", "id": "address", "label": "Address", "default": "<p>18 Marlow Yard, London E2<br/>Thursday to Sunday, 11am–6pm</p>" },
    { "type": "header", "content": "Appearance" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "light"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 80 }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
