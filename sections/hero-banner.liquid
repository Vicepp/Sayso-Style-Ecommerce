{%- liquid
  assign fallback = section.settings.fallback_image | default: 'hero-1.jpg'
-%}

<section
  class="hero hero--{{ section.settings.height }} hero--v-{{ section.settings.position_v }} hero--h-{{ section.settings.position_h }} hero--{{ section.settings.text_color }}-text"
  style="--overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
  data-section-id="{{ section.id }}"
>
  <div class="hero__media{% if settings.anim_parallax and section.settings.parallax %} parallax-media{% endif %}" {% if section.settings.parallax %}data-parallax="0.18"{% endif %}>
    {%- if section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag: image_size: '1600x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true
      }}
    {%- elsif section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 3000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '600, 900, 1200, 1600, 2000, 2600, 3000',
          sizes: '100vw',
          alt: section.settings.image.alt | default: section.settings.heading
      }}
    {%- else -%}
      <img
        src="{{ fallback | asset_url }}"
        alt="{{ section.settings.heading | escape }}"
        width="2000"
        height="2500"
        fetchpriority="high"
      >
    {%- endif -%}
  </div>

  <div class="hero__overlay"></div>

  <div class="page-width">
    <div class="hero__inner" data-reveal-group>
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow" data-reveal="rise" style="--reveal-delay: 0ms; color: currentColor; opacity: 0.8;">
          {{ section.settings.eyebrow }}
        </span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="{{ section.settings.heading_size }}" data-reveal="rise" style="--reveal-delay: 90ms;">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="rte text-lg" data-reveal="rise" style="--reveal-delay: 180ms; max-width: 46ch;">
          {{ section.settings.text }}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
        <div class="hero__buttons" data-reveal="rise" style="--reveal-delay: 270ms;">
          {%- if section.settings.button_label != blank -%}
            <a class="btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
              {{ section.settings.button_label }}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a class="btn btn--secondary" href="{{ section.settings.button_link_2 | default: routes.root_url }}">
              {{ section.settings.button_label_2 }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_scroll_cue -%}
    <div class="scroll-cue" aria-hidden="true">
      <span class="scroll-cue__line"></span>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero banner",
  "class": "hero-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "video", "id": "video", "label": "Video", "info": "Overrides the image when set." },
    {
      "type": "text",
      "id": "fallback_image",
      "label": "Fallback asset filename",
      "info": "Used before you upload your own image.",
      "default": "hero-1.jpg"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Autumn / Winter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Clothes that stay" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h0"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Slow-made pieces in linen, merino and organic cotton. Cut in small runs, built to be worn for years.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Primary link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button", "default": "Our story" },
    { "type": "url", "id": "button_link_2", "label": "Secondary link" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "position_v",
      "label": "Vertical position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "position_h",
      "label": "Horizontal position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Text colour",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "light"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Image darkening",
      "default": 30
    },
    { "type": "checkbox", "id": "parallax", "label": "Parallax scroll", "default": true },
    { "type": "checkbox", "id": "show_scroll_cue", "label": "Show scroll cue", "default": true }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
