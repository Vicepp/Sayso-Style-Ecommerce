<section
  class="section scheme-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="{% if section.settings.full_width %}page-width page-width--full{% else %}page-width{% endif %}">
    {%- if section.settings.heading != blank -%}
      <div class="section-head section-head--center" data-reveal="{{ settings.anim_reveal_style }}" {% if section.settings.full_width %}style="padding-inline: 2rem;"{% endif %}>
        <div class="section-head__text">
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          <h2>{{ section.settings.heading }}</h2>
        </div>
      </div>
    {%- endif -%}

    <div class="grid grid--{{ section.settings.columns }}" data-reveal-group {% if section.settings.full_width %}style="gap: 0.4rem;"{% endif %}>
      {%- for block in section.blocks -%}
        {%- assign block_collection = block.settings.collection -%}
        <a
          class="tile{% if section.settings.tall %} tile--tall{% endif %}"
          href="{{ block_collection.url | default: routes.all_products_collection_url }}"
          data-reveal="{{ settings.anim_reveal_style }}"
          {{ block.shopify_attributes }}
        >
          <span class="tile__media">
            {%- liquid
              assign tile_image = block.settings.image | default: block_collection.featured_image
              assign tile_index = forloop.index0 | modulo: 3 | plus: 1
              assign tile_asset = 'collection-' | append: tile_index | append: '.jpg'
              assign tile_alt = block.settings.heading | default: block_collection.title
            -%}
            {% render 'media-fallback',
              image: tile_image,
              asset: tile_asset,
              placeholder: 'collection-apparel-1',
              alt: tile_alt,
              widths: '400, 600, 900, 1200',
              sizes: '(min-width: 990px) 33vw, 50vw'
            %}
          </span>

          <span class="eyebrow" style="color: rgba(255,255,255,0.78);">
            {%- if block.settings.eyebrow != blank -%}
              {{ block.settings.eyebrow }}
            {%- elsif block_collection.all_products_count > 0 -%}
              {{ 'sections.collection.products_count' | t: count: block_collection.all_products_count }}
            {%- endif -%}
          </span>

          <h3 class="tile__title">
            {{ block.settings.heading | default: block_collection.title | default: 'Collection' }}
          </h3>

          <span class="link-arrow" style="border-bottom-color: rgba(255,255,255,0.4); align-self: start;">
            {{ section.settings.link_label }}
            {% render 'icon', name: 'arrow-right' %}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "class": "collection-list-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Categories" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop" },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    { "type": "checkbox", "id": "tall", "label": "Tall tiles", "default": false },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    { "type": "header", "content": "Appearance" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "light"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 80 }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "heading", "label": "Heading override" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
