<section
  class="section scheme-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="{% if section.settings.full_width %}page-width page-width--full{% else %}page-width{% endif %}">
    {%- if section.settings.heading != blank -%}
      <div class="section-head section-head--center" data-reveal="{{ settings.anim_reveal_style }}" {% if section.settings.full_width %}style="padding-inline: 2rem;"{% endif %}>
        <div class="section-head__text">
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          <h2>{{ section.settings.heading }}</h2>
        </div>
      </div>
    {%- endif -%}

    <div class="media media--{{ section.settings.ratio }}" data-reveal="mask" style="{% if section.settings.full_width %}border-radius: 0;{% endif %}">
      {%- if section.settings.video != blank -%}
        {{
          section.settings.video
          | video_tag:
            image_size: '1600x',
            autoplay: section.settings.autoplay,
            loop: section.settings.loop,
            muted: section.settings.autoplay,
            controls: section.settings.show_controls,
            playsinline: true
        }}
      {%- elsif section.settings.video_url != blank -%}
        <iframe
          src="{{ section.settings.video_url }}"
          title="{{ section.settings.heading | escape | default: 'Video' }}"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
          style="width: 100%; height: 100%; border: 0;"
        ></iframe>
      {%- else -%}
        {% render 'media-fallback',
          image: section.settings.cover_image,
          asset: 'hero-3.jpg',
          placeholder: 'lifestyle-1',
          alt: section.settings.heading,
          widths: '600, 900, 1400, 2400',
          sizes: '100vw'
        %}
      {%- endif -%}
    </div>

    {%- if section.settings.caption != blank -%}
      <p class="text-sm text-muted text-center" style="margin-top: 1.6rem;" data-reveal="fade">
        {{ section.settings.caption }}
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Video",
  "class": "video-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Inside the studio" },
    { "type": "video", "id": "video", "label": "Video" },
    { "type": "video_url", "id": "video_url", "label": "Video URL", "accept": ["youtube", "vimeo"] },
    { "type": "image_picker", "id": "cover_image", "label": "Cover image" },
    { "type": "text", "id": "caption", "label": "Caption" },
    {
      "type": "select",
      "id": "ratio",
      "label": "Ratio",
      "options": [
        { "value": "wide", "label": "16:9" },
        { "value": "square", "label": "1:1" },
        { "value": "portrait", "label": "3:4" }
      ],
      "default": "wide"
    },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay (muted)", "default": true },
    { "type": "checkbox", "id": "loop", "label": "Loop", "default": true },
    { "type": "checkbox", "id": "show_controls", "label": "Show controls", "default": false },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    { "type": "header", "content": "Appearance" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "light"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 80 }
  ],
  "presets": [{ "name": "Video" }]
}
{% endschema %}
