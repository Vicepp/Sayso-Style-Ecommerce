<section class="section" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="auth-card">
      <h1 class="h3 text-center" data-reveal="rise">{{ 'customer.reset_password.title' | t }}</h1>

      {%- form 'reset_customer_password', class: 'stack', style: 'margin-top: 2.4rem;' -%}
        {%- if form.errors -%}
          <div class="form__message form__message--error">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
          <input
            id="ResetPassword"
            class="input"
            type="password"
            name="customer[password]"
            autocomplete="new-password"
            required
          >
        </div>

        <div class="field">
          <label class="field__label" for="ResetPasswordConfirm">
            {{ 'customer.reset_password.password_confirm' | t }}
          </label>
          <input
            id="ResetPasswordConfirm"
            class="input"
            type="password"
            name="customer[password_confirmation]"
            autocomplete="new-password"
            required
          >
        </div>

        <button class="btn btn--full" type="submit">{{ 'customer.reset_password.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reset password",
  "class": "main-reset-password-section",
  "settings": []
}
{% endschema %}
