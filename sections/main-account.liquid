<section class="section" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="section-head">
      <div class="section-head__text">
        <span class="eyebrow">{{ 'customer.account.title' | t }}</span>
        <h1 class="h2">{{ 'customer.account.welcome' | t: name: customer.first_name | default: customer.name }}</h1>
      </div>
      <a class="link-arrow" href="{{ routes.account_logout_url }}">
        {{ 'customer.account.log_out' | t }}
        {% render 'icon', name: 'arrow-right' %}
      </a>
    </div>

    <div class="account-layout">
      <nav class="account-nav" aria-label="{{ 'customer.account.title' | t }}">
        <a class="is-active" href="{{ routes.account_url }}">{{ 'customer.account.orders' | t }}</a>
        <a href="{{ routes.account_addresses_url }}">{{ 'customer.addresses.title' | t }}</a>
        <a href="{{ routes.account_logout_url }}">{{ 'customer.account.log_out' | t }}</a>
      </nav>

      <div data-reveal="{{ settings.anim_reveal_style }}">
        {%- if customer.orders.size > 0 -%}
          <div style="overflow-x: auto;">
            <table class="order-table">
              <thead>
                <tr>
                  <th>{{ 'customer.orders.order_number' | t }}</th>
                  <th>{{ 'customer.orders.date' | t }}</th>
                  <th>{{ 'customer.orders.payment_status' | t }}</th>
                  <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
                  <th>{{ 'customer.orders.total' | t }}</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <td>{{ order.name }}</td>
                    <td>{{ order.created_at | date: '%d %b %Y' }}</td>
                    <td><span class="status-pill">{{ order.financial_status_label }}</span></td>
                    <td><span class="status-pill">{{ order.fulfillment_status_label }}</span></td>
                    <td>{{ order.total_price | money }}</td>
                    <td><a class="link-underline" href="{{ order.customer_url }}">{{ 'customer.orders.view' | t }}</a></td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>

          {%- paginate customer.orders by 20 -%}
            {% render 'pagination', paginate: paginate %}
          {%- endpaginate -%}
        {%- else -%}
          <div class="empty-state">
            {% render 'icon', name: 'bag-empty' %}
            <p class="text-muted">{{ 'customer.account.no_orders' | t }}</p>
            <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'sections.collection.browse' | t }}</a>
          </div>
        {%- endif -%}

        <div style="margin-top: 4rem; padding-top: 2.4rem; border-top: 1px solid var(--c-line);">
          <h2 class="h5">{{ 'customer.account.details' | t }}</h2>
          <div class="rte text-muted text-sm" style="margin-top: 1rem;">
            {{ customer.default_address | format_address }}
          </div>
          <a class="link-arrow" href="{{ routes.account_addresses_url }}" style="margin-top: 1.2rem;">
            {{ 'customer.account.view_addresses' | t }}
            {% render 'icon', name: 'arrow-right' %}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Account",
  "class": "main-account-section",
  "settings": []
}
{% endschema %}
