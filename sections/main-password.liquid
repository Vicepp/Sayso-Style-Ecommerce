<section class="password-page" data-section-id="{{ section.id }}">
  <div class="password-page__media">
    {% render 'media-fallback',
      image: section.settings.image,
      asset: 'hero-3.jpg',
      placeholder: 'lifestyle-1',
      alt: shop.name,
      loading: 'eager',
      widths: '600, 900, 1400, 1800, 2400',
      sizes: '100vw'
    %}
  </div>

  <div class="password-page__inner" data-reveal-group>
    <h1 class="h2" data-reveal="rise">{{ shop.name }}</h1>

    {%- if section.settings.text != blank -%}
      <div class="rte text-lg" data-reveal="rise" style="opacity: 0.9;">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- form 'customer', class: 'newsletter-form', style: 'justify-content: center;' -%}
      {%- if form.posted_successfully? -%}
        <p class="form__message form__message--success" style="width: 100%; justify-content: center;">
          {{ 'general.newsletter.success' | t }}
        </p>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="prelaunch">
        <label class="visually-hidden" for="PasswordEmail">{{ 'general.newsletter.label' | t }}</label>
        <input
          id="PasswordEmail"
          class="input"
          type="email"
          name="contact[email]"
          placeholder="{{ 'general.newsletter.placeholder' | t }}"
          required
          style="border-color: rgba(255,255,255,0.4); color: #fff;"
        >
        <button class="btn" type="submit" style="--btn-bg: #fff; --btn-fg: #111; --btn-border: #fff;">
          {{ 'general.newsletter.submit' | t }}
        </button>
      {%- endif -%}
    {%- endform -%}

    <button class="link-arrow" type="button" data-modal-open="PasswordModal" style="border-bottom-color: rgba(255,255,255,0.5);">
      {{ 'password_page.login_password_button' | t }}
    </button>

    {% render 'social-icons' %}
  </div>
</section>

<modal-element id="PasswordModal" class="modal" aria-hidden="true">
  <div class="modal__panel" style="max-width: 42rem; padding: 3.2rem;">
    <button
      class="icon-btn"
      type="button"
      data-modal-close
      aria-label="{{ 'general.close' | t }}"
      style="position: absolute; top: 0.8rem; right: 0.8rem;"
    >
      {% render 'icon', name: 'close' %}
    </button>

    <h2 class="h5" style="margin-bottom: 1.6rem;">{{ 'password_page.login_form_heading' | t }}</h2>

    {%- form 'storefront_password', class: 'stack' -%}
      {%- if form.errors -%}
        <div class="form__message form__message--error">{{ 'password_page.login_form_error' | t }}</div>
      {%- endif -%}

      <div class="field">
        <label class="field__label" for="StorefrontPassword">
          {{ 'password_page.login_form_password_label' | t }}
        </label>
        <input
          id="StorefrontPassword"
          class="input"
          type="password"
          name="password"
          placeholder="{{ 'password_page.login_form_password_placeholder' | t }}"
          autocomplete="current-password"
        >
      </div>

      <button class="btn btn--full" type="submit">{{ 'password_page.login_form_submit' | t }}</button>
    {%- endform -%}

    <p class="text-sm text-muted" style="margin-top: 1.6rem;">{{ 'password_page.admin_link_html' | t }}</p>
  </div>
</modal-element>

{% schema %}
{
  "name": "Password page",
  "class": "main-password-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Opening soon. Leave your email and we will tell you the moment the doors are unlocked.</p>"
    }
  ]
}
{% endschema %}
