<section
  class="section--flush scheme-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  style="padding-block: {{ section.settings.padding }}px; border-block: {% if section.settings.borders %}1px solid var(--c-line){% else %}0{% endif %};"
>
  <marquee-element
    style="--marquee-speed: {{ section.settings.speed }}s; --marquee-gap: {{ section.settings.gap }}px; --marquee-hover: {% if section.settings.pause_on_hover %}paused{% else %}running{% endif %};"
  >
    <div class="marquee" data-direction="{{ section.settings.direction }}">
      <div class="marquee__track">
        {%- for block in section.blocks -%}
          <span class="marquee-item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {%- else -%}
              {{ block.settings.text }}
            {%- endif -%}
            <span class="marquee-item__dot" aria-hidden="true"></span>
          </span>
        {%- else -%}
          <span class="marquee-item">
            Made slowly
            <span class="marquee-item__dot" aria-hidden="true"></span>
          </span>
        {%- endfor -%}
      </div>
    </div>
  </marquee-element>
</section>

{% schema %}
{
  "name": "Scrolling text",
  "class": "marquee-section",
  "settings": [
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "speed", "min": 10, "max": 90, "step": 5, "unit": "s", "label": "Loop duration", "default": 40 },
    { "type": "range", "id": "gap", "min": 16, "max": 120, "step": 4, "unit": "px", "label": "Gap", "default": 48 },
    { "type": "checkbox", "id": "pause_on_hover", "label": "Pause on hover", "default": true },
    { "type": "checkbox", "id": "borders", "label": "Show top and bottom rules", "default": true },
    { "type": "range", "id": "padding", "min": 8, "max": 96, "step": 4, "unit": "px", "label": "Padding", "default": 32 },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "light"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Phrase",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Made slowly" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrolling text",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
