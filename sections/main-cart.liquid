<section class="section" data-section-id="{{ section.id }}" id="MainCart">
  <div class="page-width">
    <div class="section-head">
      <div class="section-head__text">
        <h1>{{ 'sections.cart.title' | t }}</h1>
        {%- if cart.item_count > 0 -%}
          <p class="text-muted">{{ 'sections.cart.items_count' | t: count: cart.item_count }}</p>
        {%- endif -%}
      </div>
      <a class="link-arrow" href="{{ routes.all_products_collection_url }}">
        {{ 'general.continue_shopping' | t }}
        {% render 'icon', name: 'arrow-right' %}
      </a>
    </div>

    {%- if cart.item_count == 0 -%}
      <div class="empty-state">
        {% render 'icon', name: 'bag-empty' %}
        <h2 class="h3">{{ 'sections.cart.empty' | t }}</h2>
        <p class="text-muted">{{ 'sections.cart.empty_text' | t }}</p>
        <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'sections.collection.browse' | t }}</a>
      </div>
    {%- else -%}
      <div class="split" style="align-items: start; grid-template-columns: 1.6fr 1fr;">
        <div>
          {%- if settings.free_shipping_bar and settings.free_shipping_threshold > 0 -%}
            {%- assign threshold = settings.free_shipping_threshold | times: 100 -%}
            {%- assign remaining = threshold | minus: cart.total_price -%}
            {%- assign percent = cart.total_price | times: 100 | divided_by: threshold -%}
            <div class="ship-bar" data-ship-bar style="margin-bottom: 2.4rem;">
              <span data-ship-text>
                {%- if remaining > 0 -%}
                  {{ 'sections.cart.free_shipping_remaining' | t: amount: remaining | money }}
                {%- else -%}
                  {{ 'sections.cart.free_shipping_qualified' | t }}
                {%- endif -%}
              </span>
              <span class="ship-bar__track">
                <span
                  class="ship-bar__fill"
                  data-ship-fill
                  style="width: {% if percent > 100 %}100{% else %}{{ percent }}{% endif %}%"
                ></span>
              </span>
            </div>
          {%- endif -%}

          <table class="cart-table">
            <thead>
              <tr>
                <th colspan="2">{{ 'sections.cart.product' | t }}</th>
                <th>{{ 'sections.cart.quantity' | t }}</th>
                <th>{{ 'sections.cart.total' | t }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for item in cart.items -%}
                <tr class="line-item" data-line-item style="display: grid; grid-template-columns: 10rem 1fr; align-items: start;">
                  <td style="grid-row: span 2;">
                    <a class="line-item__media media media--portrait" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                      {%- if item.image -%}
                        {{ item.image | image_url: width: 280 | image_tag: loading: 'lazy', alt: item.title }}
                      {%- else -%}
                        {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      {%- endif -%}
                    </a>
                  </td>
                  <td colspan="3">
                    <div class="line-item__info">
                      <a class="line-item__title" href="{{ item.url }}">{{ item.product.title }}</a>

                      {%- unless item.product.has_only_default_variant -%}
                        <span class="line-item__variant">{{ item.variant.title }}</span>
                      {%- endunless -%}

                      {%- for property in item.properties -%}
                        {%- unless property.last == blank or property.first[0] == '_' -%}
                          <span class="line-item__variant">{{ property.first }}: {{ property.last }}</span>
                        {%- endunless -%}
                      {%- endfor -%}

                      {%- for allocation in item.line_level_discount_allocations -%}
                        <span class="line-item__discount">
                          {{ allocation.discount_application.title }} (−{{ allocation.amount | money }})
                        </span>
                      {%- endfor -%}

                      <div class="line-item__foot">
                        {%- liquid
                          assign qty_id = 'CartQty-' | append: forloop.index
                          assign qty_label = 'sections.cart.quantity' | t
                        -%}
                        {% render 'quantity-input',
                          input_id: qty_id,
                          value: item.quantity,
                          min: 0,
                          line: forloop.index,
                          label: qty_label
                        %}
                        <div style="text-align: right;">
                          <div>{{ item.final_line_price | money }}</div>
                          {%- if item.original_line_price != item.final_line_price -%}
                            <s class="text-sm text-muted">{{ item.original_line_price | money }}</s>
                          {%- endif -%}
                          <button type="button" class="line-item__remove" data-line-remove data-line="{{ forloop.index }}">
                            {{ 'sections.cart.remove' | t }}
                          </button>
                        </div>
                      </div>
                    </div>
                  </td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>

          {%- if settings.cart_show_note -%}
            <div class="field" style="margin-top: 2.4rem;">
              <label class="field__label" for="CartPageNote">{{ 'sections.cart.note' | t }}</label>
              <textarea
                id="CartPageNote"
                class="textarea"
                data-cart-note
                placeholder="{{ 'sections.cart.note_placeholder' | t }}"
              >{{ cart.note }}</textarea>
            </div>
          {%- endif -%}
        </div>

        <aside style="position: sticky; top: calc(var(--header-height) + 3rem); border: 1px solid var(--c-line); padding: 2.4rem; border-radius: var(--radius);">
          <h2 class="h5" style="margin-bottom: 1.6rem;">{{ 'sections.cart.total' | t }}</h2>

          <div class="cart-totals">
            <div class="cart-totals__row">
              <span>{{ 'sections.cart.subtotal' | t }}</span>
              <span>{{ cart.original_total_price | money }}</span>
            </div>

            {%- for discount in cart.cart_level_discount_applications -%}
              <div class="cart-totals__row" style="color: var(--c-success);">
                <span>{{ discount.title }}</span>
                <span>−{{ discount.total_allocated_amount | money }}</span>
              </div>
            {%- endfor -%}

            <div class="cart-totals__row cart-totals__row--total">
              <span>{{ 'sections.cart.total' | t }}</span>
              <span>{{ cart.total_price | money_with_currency }}</span>
            </div>
          </div>

          {%- if settings.cart_footer_text != blank -%}
            <div class="rte text-sm text-muted" style="margin-block: 1.6rem;">{{ settings.cart_footer_text }}</div>
          {%- endif -%}

          <form action="{{ routes.cart_url }}" method="post" novalidate>
            <button type="submit" name="checkout" class="btn btn--full" data-checkout>
              {{ 'sections.cart.checkout' | t }}
            </button>
          </form>

          {%- if additional_checkout_buttons -%}
            <div style="margin-top: 1.2rem;">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}

          {%- if section.settings.show_discount_field -%}
            <form class="row" data-discount-form style="margin-top: 1.6rem; gap: 0.8rem;">
              <label class="visually-hidden" for="CartDiscount">{{ 'sections.cart.discount' | t }}</label>
              <input id="CartDiscount" class="input" type="text" name="discount" placeholder="{{ 'sections.cart.discount' | t }}">
              <button class="btn btn--secondary btn--small" type="submit">{{ 'sections.cart.apply' | t }}</button>
            </form>
          {%- endif -%}

          {%- if shop.enabled_payment_types.size > 0 -%}
            <div class="payment-icons" style="margin-top: 2rem; justify-content: center;">
              {%- for type in shop.enabled_payment_types -%}
                {{ type | payment_type_svg_tag }}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </aside>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "class": "main-cart-section",
  "settings": [
    { "type": "checkbox", "id": "show_discount_field", "label": "Show discount code field", "default": true }
  ]
}
{% endschema %}
