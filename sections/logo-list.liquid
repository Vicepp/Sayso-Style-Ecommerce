<section
  class="section--flush scheme-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <p class="eyebrow text-center" style="margin-bottom: 2.4rem;" data-reveal="fade">{{ section.settings.heading }}</p>
    {%- endif -%}

    <div class="logo-strip" data-reveal-group>
      {%- for block in section.blocks -%}
        {%- capture logo_markup -%}
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 400
              | image_tag: loading: 'lazy', alt: block.settings.name | default: 'Press logo'
            }}
          {%- else -%}
            <span class="h4" style="opacity: 0.5;">{{ block.settings.name | default: 'Press' }}</span>
          {%- endif -%}
        {%- endcapture -%}

        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" target="_blank" rel="noopener" data-reveal="fade" {{ block.shopify_attributes }}>
            {{ logo_markup }}
          </a>
        {%- else -%}
          <span data-reveal="fade" {{ block.shopify_attributes }}>{{ logo_markup }}</span>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Logo list",
  "class": "logo-list-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "As seen in" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "light"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "name", "label": "Name", "default": "Publication" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo list",
      "blocks": [{ "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }]
    }
  ]
}
{% endschema %}
