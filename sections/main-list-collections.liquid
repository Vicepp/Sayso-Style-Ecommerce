<section class="section" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="section-head section-head--center" data-reveal="{{ settings.anim_reveal_style }}">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h1>{{ section.settings.heading | default: page_title }}</h1>
        {%- if section.settings.text != blank -%}
          <div class="rte text-muted" style="margin-top: 1rem;">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    </div>

    {%- liquid
      if section.settings.sort == 'alphabetical'
        assign list = collections | sort: 'title'
      elsif section.settings.sort == 'products_high'
        assign list = collections | sort: 'all_products_count' | reverse
      else
        assign list = collections
      endif
    -%}

    <div class="grid grid--{{ section.settings.columns }}" data-reveal-group>
      {%- for list_collection in list -%}
        <a class="tile{% if section.settings.tall %} tile--tall{% endif %}" href="{{ list_collection.url }}" data-reveal="{{ settings.anim_reveal_style }}">
          <span class="tile__media">
            {%- if list_collection.featured_image -%}
              {{
                list_collection.featured_image
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 500, 700, 1000',
                  sizes: '(min-width: 990px) 33vw, 50vw',
                  alt: list_collection.title
              }}
            {%- else -%}
              {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </span>
          <span class="eyebrow" style="color: rgba(255,255,255,0.78);">
            {{ 'sections.collection.products_count' | t: count: list_collection.all_products_count }}
          </span>
          <h2 class="tile__title">{{ list_collection.title }}</h2>
        </a>
      {%- else -%}
        <p class="text-muted">{{ 'sections.collection.empty' | t }}</p>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "class": "list-collections-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Everything" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Browse the wardrobe by category, season or fabric.</p>"
    },
    {
      "type": "select",
      "id": "sort",
      "label": "Sort collections",
      "options": [
        { "value": "manual", "label": "As arranged in admin" },
        { "value": "alphabetical", "label": "A–Z" },
        { "value": "products_high", "label": "Most products first" }
      ],
      "default": "manual"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    { "type": "checkbox", "id": "tall", "label": "Tall tiles", "default": false }
  ]
}
{% endschema %}
