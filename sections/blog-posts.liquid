{%- liquid
  assign target_blog = blogs[section.settings.blog]
  assign posts = target_blog.articles
-%}

<section
  class="section scheme-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="section-head" data-reveal="{{ settings.anim_reveal_style }}">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if target_blog != blank -%}
        <a class="link-arrow" href="{{ target_blog.url }}">
          {{ 'general.view_all' | t }}
          {% render 'icon', name: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>

    <div class="grid grid--{{ section.settings.columns }}" data-reveal-group>
      {%- if posts.size > 0 -%}
        {%- for article in posts limit: section.settings.posts_to_show -%}
          {% render 'article-card',
            article: article,
            show_excerpt: section.settings.show_excerpt,
            index: forloop.index0
          %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.posts_to_show) -%}
          <div class="article-card" data-reveal="{{ settings.anim_reveal_style }}">
            <div class="article-card__media media media--wide">
              {{ 'blog-apparel-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="article-card__meta"><span>{{ 'now' | date: '%d %B %Y' }}</span></div>
            <h3 class="article-card__title">{{ 'onboarding.article_title' | t }}</h3>
            <p class="article-card__excerpt">{{ 'onboarding.article_excerpt' | t }}</p>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog posts",
  "class": "blog-posts-section",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reading" },
    { "type": "range", "id": "posts_to_show", "min": 2, "max": 9, "step": 1, "label": "Posts to show", "default": 3 },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true },
    { "type": "header", "content": "Appearance" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "light"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 80 }
  ],
  "presets": [{ "name": "Blog posts" }]
}
{% endschema %}
